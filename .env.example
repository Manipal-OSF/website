# Optional for the public site. Copy this file to .env.local when needed.

# Neon PostgreSQL connection string; leave blank until database features are added.
# Example: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# Better Auth is installed for future use; no auth routes are configured yet.
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend API key and a sender address on your verified domain.
# Local email previews do not need these values.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
