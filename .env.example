# Optional for the public site. Copy this file to .env at the repository root.
# All workspace commands load root .env files; process variables take precedence.

# Neon runtime connection string; required for the forum, optional for Astro.
# Example: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# Direct connections for migration and moderator commands. Never used interchangeably.
DEV_DATABASE_URL=
PROD_DATABASE_URL=

# Authentication is hosted by the Next.js forum app.
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cross-app links. Development defaults to localhost ports 3000 and 4321.
# Set the forum's full /forum URL on the Astro Vercel project to show its nav link.
PUBLIC_FORUM_URL=
# Defaults to https://manipalosf.org in production.
PUBLIC_SITE_URL=

# Required for forum signup, email verification, and password recovery.
# Resend API key and a sender address on your verified domain.
# Local email previews do not need these values.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional GitHub token for a higher API rate limit.
GITHUB_TOKEN=
