# Optional for the public site. Copy this file to .env at the repository root.
# All workspace commands load root .env files; process variables take precedence.

# Neon PostgreSQL connection string; leave blank until database features are added.
# Example: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# Shared auth factories are ready for future use; no auth routes are mounted.
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend API key and a sender address on your verified domain.
# Local email previews do not need these values.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional GitHub token for a higher API rate limit.
GITHUB_TOKEN=
