{
  "name": "website",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "with-env development turbo run dev --filter='./apps/*'",
    "build": "with-env production turbo run build",
    "start": "pnpm --filter @apps/astro start",
    "lint": "turbo run lint",
    "typecheck": "with-env production turbo run typecheck",
    "test": "with-env test turbo run test",
    "email:dev": "pnpm --filter @packages/email dev",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build:local": "pnpm --filter @apps/astro build:local",
    "dev:forum": "pnpm --filter @apps/nextjs dev",
    "start:forum": "pnpm --filter @apps/nextjs start",
    "auth:generate": "pnpm --filter @apps/nextjs auth:generate",
    "test:forum": "pnpm --filter @apps/nextjs test",
    "test:auth": "pnpm --filter @apps/nextjs exec tsx --test tests/auth.test.ts",
    "test:db": "pnpm --filter @packages/db test",
    "db:generate": "pnpm --filter @packages/db db:generate",
    "db:check": "pnpm --filter @packages/db db:check",
    "db:migrate": "pnpm --filter @packages/db db:migrate",
    "db:migrate:dev": "pnpm --filter @packages/db db:migrate:dev",
    "db:migrate:prod": "pnpm --filter @packages/db db:migrate:prod",
    "forum:moderator": "pnpm --filter @packages/db forum:moderator"
  },
  "devDependencies": {
    "@packages/env": "workspace:*",
    "@tooling/prettier": "workspace:*",
    "prettier": "catalog:",
    "turbo": "^2.5.0"
  },
  "prettier": "@tooling/prettier"
}
