---
import BentoCell from './BentoCell.astro';
import ArrowUpRight from '@/components/icons/ArrowUpRight.astro';
interface Props {
  area: string;
  href: string;
  title: string;
  detail?: string;
  note?: string;
  image?: string;
}
const { area, href, title, detail, note, image } = Astro.props;
const external = href.startsWith('http');
---

<BentoCell area={area} note={note} noteClassName='top-3 right-9'>
  <a
    href={href}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
    class='hover:bg-muted/60 flex h-full flex-col justify-between p-4 transition-colors'
  >
    {
      image && (
        <img
          src={image}
          alt=''
          loading='lazy'
          width='600'
          height='400'
          class='absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-200 group-hover:opacity-30 motion-reduce:transition-none'
        />
      )
    }
    <span
      class='text-muted-foreground group-hover:text-primary relative transition-[color,scale] duration-300 group-hover:scale-110 [&>svg]:size-9 sm:[&>svg]:size-11'
      ><slot name='icon' /></span
    >
    <span class='relative flex flex-col'
      ><span class='font-medium'>{title}</span>{
        detail && <span class='text-muted-foreground text-xs'>{detail}</span>
      }</span
    >
    <ArrowUpRight
      className='text-muted-foreground absolute top-3 right-3 size-4 -translate-x-1 translate-y-1 opacity-0 transition-[opacity,translate] group-hover:translate-0 group-hover:opacity-100'
    />
  </a>
</BentoCell>
