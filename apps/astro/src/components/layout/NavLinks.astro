---
import { activeNavItem, navItems } from '@/lib/site';
import { env } from '@packages/env';
const active = activeNavItem(Astro.url.pathname);
const forumUrl =
  env.PUBLIC_FORUM_URL ??
  (import.meta.env.DEV ? 'http://localhost:3000/forum' : undefined);
---

{
  navItems.map((item) => (
    <li>
      <a
        href={item.href}
        aria-current={item === active ? 'page' : undefined}
        class={`transition-colors ${item === active ? 'text-foreground' : 'hover:text-foreground'}`}
      >
        {item.label}
      </a>
    </li>
  ))
}
{
  forumUrl && (
    <li>
      <a href={forumUrl} class='hover:text-foreground transition-colors'>
        Forum
      </a>
    </li>
  )
}
