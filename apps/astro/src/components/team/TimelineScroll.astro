<script>
  const clamp = (value: number) => Math.min(1, Math.max(0, value));
  for (const timeline of document.querySelectorAll<HTMLElement>('.timeline')) {
    if (
      CSS.supports('animation-timeline: view()') ||
      matchMedia('(prefers-reduced-motion: reduce)').matches
    )
      continue;
    const rows = [...timeline.querySelectorAll<HTMLElement>('.timeline-row')];

    let frame = 0;
    const update = () => {
      frame = 0;
      const height = innerHeight;
      // Same offsets as the CSS: the rail fills while the timeline crosses
      // the middle of the viewport, and a year lights up as its row's top
      // moves from 55% to 45% of the viewport.
      const box = timeline.getBoundingClientRect();
      timeline.style.setProperty(
        '--timeline-progress',
        String(clamp((height / 2 - box.top) / box.height)),
      );
      for (const row of rows) {
        const { top } = row.getBoundingClientRect();
        row.style.setProperty(
          '--timeline-row-progress',
          String(clamp((height * 0.55 - top) / (height * 0.1))),
        );
      }
    };
    // At most one update per frame, however often scroll events fire.
    const schedule = () => {
      frame ||= requestAnimationFrame(update);
    };

    update();
    timeline.dataset.scroll = 'script';
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule, { passive: true });
  }
</script>
