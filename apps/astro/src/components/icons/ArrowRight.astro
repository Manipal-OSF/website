import type { HTMLAttributes } from 'astro/types';
type SVGAttributes = HTMLAttributes<'svg'>;
interface Props extends SVGAttributes {
  className?: string;
}
const { className, ...props } = Astro.props;
---

<svg
  xmlns='http://www.w3.org/2000/svg'
  width='24'
  height='24'
  viewBox='0 0 24 24'
  fill='none'
  stroke='currentColor'
  stroke-width='2'
  stroke-linecap='round'
  stroke-linejoin='round'
  aria-hidden='true'
  class={className}
  {...props}
>
  <path d='M5 12h14'></path>
  <path d='m12 5 7 7-7 7'></path>
</svg>
