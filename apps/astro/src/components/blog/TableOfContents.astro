---
import { cn } from '@packages/ui/lib/utils';
import type { PostHeading } from '@/types/blog';
import HeadingList from './HeadingList.astro';
interface TableOfContentsProps {
  headings: PostHeading[];
  className?: string;
}
const { headings, className } = Astro.props as TableOfContentsProps;
---

{
  headings.length > 0 ? (
    <nav
      aria-label='Table of contents'
      class={cn(
        'sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pr-4',
        className,
      )}
    >
      <>
        <p class='text-foreground mb-3 text-lg font-medium'>
          Table of Contents
        </p>
        <HeadingList headings={headings} />
      </>
    </nav>
  ) : null
}
