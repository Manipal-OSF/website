---
import { resolveAuthors } from '@/lib/content/authors';
import type { BlogPost } from '@/types/blog';
import CoverImage from './CoverImage.astro';
import PostMeta from './PostMeta.astro';
import Tags from './Tags.astro';
type BlogCardProps = {
  post: Pick<
    BlogPost,
    | 'id'
    | 'title'
    | 'description'
    | 'authors'
    | 'publishDate'
    | 'readingTime'
    | 'tags'
    | 'coverImage'
  >;
};
const { post } = Astro.props as BlogCardProps;
const authors = await resolveAuthors(post.authors);
---

<a
  href={`/blog/${post.id}`}
  class='hover:bg-muted/50 flex flex-col gap-4 rounded-xl border p-4 transition-colors sm:flex-row'
  ><CoverImage
    src={post.coverImage}
    alt={post.title}
    sizes='(min-width: 640px) 16rem, 100vw'
    className='w-full shrink-0 rounded-md sm:w-64'
  /><div class='flex flex-col gap-2'>
    <h2 class='text-foreground text-lg font-medium'>{post.title}</h2>{
      post.description && (
        <p class='text-muted-foreground text-sm'>{post.description}</p>
      )
    }<PostMeta
      authors={authors}
      publishDate={post.publishDate}
      readingTime={post.readingTime}
    /><Tags tags={post.tags} />
  </div></a
>
