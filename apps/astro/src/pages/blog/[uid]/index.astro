---
import SiteLayout from '@/layouts/SiteLayout.astro';
import AuthorProfiles from '@/components/authors/AuthorProfiles.astro';
import CoverImage from '@/components/blog/CoverImage.astro';

import PostHeader from '@/components/blog/PostHeader.astro';
import PostNavigation from '@/components/blog/PostNavigation.astro';
import MobileTableOfContents from '@/components/blog/MobileTableOfContents.astro';
import TableOfContentsSidebar from '@/components/blog/TableOfContents.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import Container from '@/components/common/Container.astro';
import JsonLd from '@/components/common/JsonLd.astro';
import { resolveAuthors } from '@/lib/content/authors';
import { absoluteUrl, pageMetadata } from '@/lib/seo';
import { siteName, siteUrl } from '@/lib/site';

import { getCollection, render } from 'astro:content';
import {
  getPublishedPosts,
  getPost,
  getAdjacentPosts,
} from '@/lib/content/posts';
export async function getStaticPaths() {
  return (await getPublishedPosts()).map((post) => ({
    params: { uid: post.id },
  }));
}
const post = await getPost(Astro.params.uid!);
if (!post) return Astro.redirect('/404');
const [authors, { newer, older }] = await Promise.all([
  resolveAuthors(post.authors),
  getAdjacentPosts(post.id),
]);
const entry = (await getCollection('posts')).find(
  (entry) => entry.data.id === post.id,
)!;
const { Content } = await render(entry);
const url = absoluteUrl(`/blog/${post.id}`);
const metadata = pageMetadata({
  title: post.title,
  description: post.description ?? undefined,
  path: `/blog/${post.id}`,
  image: `/blog/${post.id}/opengraph-image`,
  openGraph: {
    type: 'article',
    publishedTime: post.publishDate,
    authors: authors.map((author) => author.name),
    tags: post.tags,
  },
});
---

<SiteLayout metadata={metadata}>
  <article data-wide class='flex w-full flex-col gap-6'>
    <JsonLd
      data={{
        '@type': 'BlogPosting',
        '@id': `${url}#article`,
        mainEntityOfPage: url,
        url,
        headline: post.title,
        description: post.description ?? undefined,
        image: absoluteUrl(
          post.coverImage ?? `/blog/${post.id}/opengraph-image`,
        ),
        datePublished: post.publishDate,
        keywords: post.tags.length ? post.tags.join(', ') : undefined,
        inLanguage: 'en',
        author: authors.map((author) => ({
          '@type': 'Person',
          name: author.name,
          url: author.isRegistered
            ? absoluteUrl(`/authors/${author.id}`)
            : undefined,
        })),
        publisher: {
          '@type': 'Organization',
          '@id': `${siteUrl}/#organization`,
          name: siteName,
          logo: absoluteUrl('/logo.png'),
        },
      }}
    /><Container
      ><Breadcrumbs
        items={[{ label: 'Blog', href: '/blog' }, { label: post.title }]}
      /></Container
    ><CoverImage
      src={post.coverImage}
      alt={post.title}
      sizes='(min-width: 64rem) 64rem, 100vw'
      preload
      className='mx-auto aspect-[1200/630] w-full max-w-5xl rounded-xl'
    /><Container><PostHeader post={post} authors={authors} /></Container><div
      class='grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_48rem_minmax(0,1fr)]'
    >
      <aside class='hidden xl:block'>
        <TableOfContentsSidebar headings={post.headings} className='pr-8' />
      </aside><Container className='flex flex-col gap-6'
        ><MobileTableOfContents
          headings={post.headings}
          className='xl:hidden'
        /><div
          class='prose w-full [&_:is(h2,h3,h4,h5,h6)]:scroll-mt-28 xl:[&_:is(h2,h3,h4,h5,h6)]:scroll-mt-20'
        >
          <Content />
        </div><AuthorProfiles authors={authors} /><PostNavigation
          newer={newer}
          older={older}
        /></Container
      >
    </div>
  </article>
</SiteLayout>
