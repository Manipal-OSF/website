---
import SiteLayout from '@/layouts/SiteLayout.astro';
import JsonLd from '@/components/common/JsonLd.astro';
import MemberLoop from '@/components/team/MemberLoop.astro';
import Timeline from '@/components/team/Timeline.astro';
import { absoluteUrl, pageMetadata } from '@/lib/seo';
import { getTeam } from '@/lib/team';
import { siteName, siteUrl } from '@/lib/site';
import type { Person } from '@/lib/timeline';

import { withGitHubRender } from '@/lib/github';
export const prerender = false;
const { timeline, community, unavailable } = await withGitHubRender(
  Astro.request,
  () => getTeam(),
);
if (unavailable) {
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
}
const first = timeline[0].year;
const founders = timeline[0].milestones
  .flatMap((milestone) => milestone.people ?? [])
  .filter(({ role }) => role === 'founder' || role === 'co-founder');
const description = `The story of ${siteName}, from its founding in 2021 to today.`;
const metadata = pageMetadata({ title: 'Team', description, path: '/team' });
const person = ({ name, href }: Person) => ({
  '@type': 'Person',
  name,
  ...(href && { url: href.startsWith('/') ? absoluteUrl(href) : href }),
});
---

<SiteLayout metadata={metadata}>
  <div
    class='mx-auto flex w-full max-w-4xl flex-col gap-16 py-8 md:gap-24 md:py-12'
  >
    <JsonLd
      data={{
        '@type': 'AboutPage',
        name: `Team | ${siteName}`,
        url: absoluteUrl('/team'),
        description,
        isPartOf: { '@id': `${siteUrl}/#website` },
        mainEntity: {
          '@type': 'Organization',
          '@id': `${siteUrl}/#organization`,
          name: siteName,
          foundingDate: String(first),
          founder: founders.map(person),
          member: community.map(person),
        },
      }}
    /><header class='flex flex-col gap-4'>
      <h1 class='text-3xl font-semibold text-balance sm:text-5xl'>
        Established since <span class='text-awesome'>{first}</span>
      </h1><p
        class='text-muted-foreground max-w-xl text-sm text-pretty sm:text-base'
      >
        A timeline of all events and projects undertaken by OSF thus far.
      </p>
    </header><Timeline data={timeline} />{
      community.length > 0 && (
        <section class='flex flex-col gap-4'>
          <>
            <div class='flex flex-col gap-1'>
              <>
                <h2 class='text-lg font-medium'>Our community</h2>
                <p class='text-muted-foreground text-sm'>
                  All the other members and contributors who form our large
                  community.
                </p>
              </>
            </div>
            <MemberLoop people={community} />
          </>
        </section>
      )
    }
  </div>
</SiteLayout>
