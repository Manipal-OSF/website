---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { absoluteUrl, feedPath, type PageMetadata } from '@/lib/seo';
import { siteDescription, siteName } from '@/lib/site';
import { themeScript } from '@/lib/theme';
import '@/styles/globals.css';
interface Props {
  metadata?: PageMetadata;
}
const { metadata = { path: Astro.url.pathname } } = Astro.props;
const title = metadata.title ? `${metadata.title} | ${siteName}` : siteName;
const description = metadata.description ?? siteDescription;
const image = absoluteUrl(metadata.image ?? '/opengraph-image');
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <script is:inline set:html={themeScript} />
    <title>{title}</title>
    <meta name='description' content={description} />
    <meta name='application-name' content={siteName} />
    <meta name='color-scheme' content='light dark' />
    <meta
      name='theme-color'
      media='(prefers-color-scheme: light)'
      content='#eceff4'
    />
    <meta
      name='theme-color'
      media='(prefers-color-scheme: dark)'
      content='#1e1e2e'
    />
    <meta name='robots' content='index, follow' />
    <meta name='googlebot' content='max-image-preview:large, max-snippet:-1' />
    <link rel='canonical' href={absoluteUrl(metadata.path)} />
    <link
      rel='alternate'
      type='application/rss+xml'
      title={`${siteName} Blog`}
      href={feedPath}
    />
    <link rel='icon' href='/icon.png' type='image/png' />
    <link rel='apple-touch-icon' href='/apple-icon.png' />
    <link rel='manifest' href='/manifest.webmanifest' />
    <meta property='og:site_name' content={siteName} />
    <meta property='og:locale' content='en_IN' />
    <meta property='og:type' content={metadata.openGraph?.type ?? 'website'} />
    <meta property='og:title' content={metadata.title ?? siteName} />
    <meta property='og:description' content={description} />
    <meta property='og:url' content={absoluteUrl(metadata.path)} />
    <meta property='og:image' content={image} />
    <meta property='og:image:width' content='1200' /><meta
      property='og:image:height'
      content='630'
    />
    <meta property='og:image:alt' content={metadata.title ?? siteName} />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={metadata.title ?? siteName} />
    <meta name='twitter:description' content={description} /><meta
      name='twitter:image'
      content={image}
    />
    {
      metadata.openGraph?.publishedTime && (
        <meta
          property='article:published_time'
          content={metadata.openGraph.publishedTime}
        />
      )
    }
    {
      metadata.openGraph?.authors?.map((author) => (
        <Fragment>
          <>
            <meta property='article:author' content={author} />
            <meta name='author' content={author} />
          </>
        </Fragment>
      ))
    }
    {
      metadata.openGraph?.tags?.map((tag) => (
        <meta property='article:tag' content={tag} />
      ))
    }
    {
      metadata.openGraph?.tags?.length && (
        <meta name='keywords' content={metadata.openGraph.tags.join(', ')} />
      )
    }
  </head>
  <body class='bg-background text-foreground'>
    <div
      class='bg-background text-foreground flex min-h-screen flex-col gap-y-6 font-sans'
    >
      <Header />
      <div class='flex grow flex-col'>
        <main
          class='mx-auto flex w-full max-w-5xl grow flex-col gap-y-6 overflow-clip px-4 has-[[data-wide]]:max-w-7xl'
        >
          <slot />
        </main>
      </div>
      <Footer />
    </div>
    <Analytics /><SpeedInsights />
  </body>
</html>
